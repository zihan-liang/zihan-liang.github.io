---
import type { ResearchProject } from '../data/research';

interface Props {
  project: ResearchProject;
  detailed?: boolean;
}

const { project, detailed = false } = Astro.props;
---

<article class:list={['card', 'project-card', { 'project-card--detailed': detailed }]}>
  <div class="card-meta">
    <span class="tag">{project.category}</span>
    <span>{project.period}</span>
  </div>
  <h3>{project.title}</h3>
  <p class="role">{project.role}</p>
  <p>{detailed ? project.summary : project.homepageSummary}</p>
  {detailed && (
    <div class="project-details">
      <div>
        <h4>Contributions</h4>
        <ul>{project.contributions.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h4>Methods</h4>
        <ul class="method-list">{project.methods.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h4>Results</h4>
        <ul>{project.results.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  )}
  <div class="card-links">
    {project.links.map((link) => <a href={link.url}>{link.label}<span aria-hidden="true"> ↗</span></a>)}
    {!detailed && <a href="/research/">Research details<span aria-hidden="true"> →</span></a>}
  </div>
</article>
