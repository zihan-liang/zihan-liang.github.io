---
import { getCollection } from 'astro:content';
import HonorRow from '../components/HonorRow.astro';
import OutputCard from '../components/OutputCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ResearchProjectCard from '../components/ResearchProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import UpdateRow from '../components/UpdateRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { researchProjects } from '../data/research';

const outputs = (await getCollection('outputs'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
const projects = (await getCollection('projects'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title));
const researchEngineeringProjects = projects.filter((entry) => entry.data.category !== 'software');
const softwareProjects = projects.filter((entry) => entry.data.category === 'software');
const honors = (await getCollection('honors'))
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
const awards = honors.filter((entry) => entry.data.kind === 'award');
const presentations = honors.filter((entry) => entry.data.kind === 'presentation');
const updates = (await getCollection('updates'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const description = 'Machine learning for time-series forecasting and sequential social-media risk assessment by undergraduate AI researcher Zihan Liang.';
---

<BaseLayout title="Zihan Liang | AI Research" description={description}>
  <section id="about" class="hero" aria-labelledby="home-title">
    <div class="hero-inner">
      <div>
        <p class="hero-kicker">Machine learning · Research engineering</p>
        <h1 id="home-title">Zihan Liang</h1>
        <p class="hero-positioning">{profile.title}</p>
        <p class="hero-copy">{profile.biography}</p>
        <div class="hero-actions">
          <a class="button-link" href={profile.cvPath} download>Academic Research CV</a>
          <a class="button-link button-link--quiet" href={`mailto:${profile.email}`}>Email me</a>
        </div>
        <dl class="hero-achievements">
          <div data-claim-ids="education-stage-two"><dt>Programme rank</dt><dd>1st <span>Stage 2 · 78/100</span></dd></div>
          <div data-claim-ids="mcm-finalist"><dt>Mathematical modeling</dt><dd>MCM Finalist <span>2026 · Team result</span></dd></div>
          <div data-claim-ids="suicide-poster icsc-presentation"><dt>Research communication</dt><dd>ICSC 2025 <span>First-authored poster</span></dd></div>
        </dl>
      </div>
      <figure class="portrait-frame">
        <div class="portrait-crop">
          <img
            src={profile.portraitPath}
            srcset={`${profile.portraitSmallPath} 640w, ${profile.portraitPath} 960w`}
            sizes="(max-width: 768px) 82vw, 28vw"
            alt={profile.portraitAlt}
            width="960"
            height="1344"
            fetchpriority="high"
          />
        </div>
      </figure>
    </div>
  </section>

  <section id="research" class="section-shell" aria-labelledby="research-title">
    <SectionHeading id="research-title" eyebrow="Research" title="Research interests" introduction="My research asks how models can align mixed-frequency evidence and preserve long user histories while remaining carefully evaluated and interpretable." actionHref="/research/" actionLabel="Research narratives" />
    <div class="theme-grid">
      {profile.researchThemes.map((theme, index) => (
        <article class="theme-card">
          <p class="eyebrow">0{index + 1}</p>
          <h3>{theme.title}</h3>
          <p>{theme.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="news" class="section-shell" aria-labelledby="news-title">
    <SectionHeading id="news-title" eyebrow="News" title="Recent milestones" introduction="Selected research, presentation, and competition updates." />
    <div class="update-list">
      {updates.map((entry) => <UpdateRow entry={entry} />)}
    </div>
  </section>

  <section id="outputs" class="section-shell" aria-labelledby="outputs-title">
    <SectionHeading id="outputs-title" eyebrow="Research outputs" title="Preprint and conference poster" introduction="Selected preprint and poster records. The outputs page includes a related technical report." actionHref="/outputs/" actionLabel="All outputs" />
    <div class="card-grid">
      {outputs.map((entry) => <OutputCard entry={entry} />)}
    </div>
  </section>

  <section id="projects" class="section-shell" aria-labelledby="projects-title">
    <SectionHeading id="projects-title" eyebrow="Research projects" title="Research projects" introduction="Time-series forecasting, sequential risk assessment, and applied AI engineering." actionHref="/projects/" actionLabel="All project details" />
    <div class="portal-grid portal-grid--two">
      {researchProjects.map((project) => <ResearchProjectCard project={project} />)}
      {researchEngineeringProjects.map((entry) => <ProjectCard entry={entry} />)}
    </div>
  </section>

  <section id="software" class="section-shell" aria-labelledby="software-title">
    <SectionHeading id="software-title" eyebrow="Software projects" title="Software" introduction="Selected software projects with concrete public repositories where available." actionHref="/projects/" actionLabel="Software details" />
    <div class="portal-grid portal-grid--two">
      {softwareProjects.map((entry) => <ProjectCard entry={entry} />)}
    </div>
  </section>

  <section id="honors" class="section-shell" aria-labelledby="honors-title">
    <SectionHeading id="honors-title" eyebrow="Honors and awards" title="Honors and awards" introduction="Selected recognition across research, engineering, and team mathematical modeling." actionHref="/honors/" actionLabel="Honors details" />
    <div class="honor-list">
      {awards.map((entry) => <HonorRow entry={entry} />)}
    </div>
  </section>

  <section id="presentations" class="section-shell" aria-labelledby="presentations-title">
    <SectionHeading id="presentations-title" eyebrow="Presentations" title="Presentations" introduction="Poster and oral research presentations." actionHref="/honors/" actionLabel="Presentation details" />
    <div class="honor-list">
      {presentations.map((entry) => <HonorRow entry={entry} />)}
    </div>
  </section>

  <section id="education" class="section-shell" aria-labelledby="education-title">
    <SectionHeading id="education-title" eyebrow="Education" title={profile.institution} introduction={`${profile.education.programme}. Expected graduation ${profile.education.expectedGraduation}.`} />
    <div class="cv-summary">
      <dl class="fact-list">
        <div><dt>Stage</dt><dd>{profile.education.standing}</dd></div>
        <div><dt>Focus</dt><dd>Artificial intelligence, machine learning, mathematical modeling, and research engineering</dd></div>
      </dl>
      <aside class="research-narrative">
        <p class="eyebrow">Academic direction</p>
        <p>Undergraduate study at XJTLU supports research across quantitative AI and NLP-driven social computing.</p>
      </aside>
    </div>
  </section>

  <section id="cv" class="section-shell" aria-labelledby="cv-title">
    <SectionHeading id="cv-title" eyebrow="CV and contact" title="Continue the conversation" introduction="Download the latest approved academic CV or get in touch about research and collaboration." actionHref="/cv/" actionLabel="CV profile" />
    <div class="contact-grid">
      <div class="download-panel">
        <p class="eyebrow">Academic CV</p>
        <h3>Academic Research CV</h3>
        <p>Three-page English CV with research, education, and selected achievements.</p>
        <a class="button-link" href={profile.cvPath} download>Download CV</a>
      </div>
      <div class="download-panel">
        <p class="eyebrow">Contact</p>
        <h3>Research and project links</h3>
        <p>Email is the best route for research enquiries. Public work is collected on GitHub.</p>
        <div class="hero-actions">
          <a class="button-link" href={`mailto:${profile.email}`}>Email Zihan</a>
          <a class="button-link button-link--quiet" href={profile.github}>GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
